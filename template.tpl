___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const createQueue = require('createQueue');
const encodeUriComponent = require('encodeUriComponent');
const JSON = require('JSON');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const getType = require('getType');
const logToConsole = require('logToConsole');

const COOKIE = 'cookieren_consent';
const g = function (b) { return b ? 'granted' : 'denied'; };

// 1) Defaults: everything denied until the visitor decides
const defaults = {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: makeInteger(data.waitForUpdate || '500')
};
const regionList = [];
if (data.regions) {
  makeString(data.regions).split(',').forEach(function (r) {
    const t = r.trim().toUpperCase();
    if (t) regionList.push(t);
  });
}
if (regionList.length > 0) {
  defaults.region = regionList;
}
setDefaultConsentState(defaults);

gtagSet({
  ads_data_redaction: data.adsDataRedaction === true,
  url_passthrough: data.urlPassthrough === true
});

if (data.uetDefault !== false) {
  createQueue('uetq')('consent', 'default', { ad_storage: 'denied' });
}

// 2) Returning visitor: restore the saved choice before any other tag fires
const raw = getCookieValues(COOKIE, true)[0];
if (raw) {
  const saved = JSON.parse(raw);
  if (saved && getType(saved) === 'object' && saved.c && getType(saved.c) === 'object') {
    updateConsentState({
      ad_storage: g(saved.c.marketing),
      ad_user_data: g(saved.c.marketing),
      ad_personalization: g(saved.c.marketing),
      analytics_storage: g(saved.c.analytics),
      functionality_storage: g(saved.c.functional),
      personalization_storage: g(saved.c.functional),
      security_storage: 'granted'
    });
    if (data.uetDefault !== false) {
      createQueue('uetq')('consent', 'update', { ad_storage: g(saved.c.marketing) });
    }
  }
}

// 3) Load the account's banner (design, texts and cookie list come from the Cookieren admin)
setInWindow('CookierenGTM', { siteId: data.siteId }, true);

// Consent defaults are set synchronously, so other tags never wait for the banner download.
data.gtmOnSuccess();

const url = data.serverUrl + '/s/' + encodeUriComponent(data.siteId) + '.js';
injectScript(url, function () {}, function () {
  logToConsole('Cookieren: the banner could not be loaded: ' + url);
}, 'cookieren');


